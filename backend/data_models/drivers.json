{
    "title": "drivers",
    "type": "object",
    "properties": {
        "id": {
            "type": "integer"
        },
        "first_name": {
            "type": "string"
        },
        "last_name": {
            "type": "string"
        },
        "phone": {
            "type": "string"
        },
        "status": {
            "type": "string",
            "enum": [
                "online",
                "offline",
                "on_ride",
                "suspended"
            ],
            "default": "offline"
        },
        "vehicle_id": {
            "type": "integer"
        },
        "license_number": {
            "type": "string"
        },
        "rating": {
            "type": "number",
            "default": 5.0
        },
        "total_rides": {
            "type": "integer",
            "default": 0
        },
        "daily_earnings": {
            "type": "integer",
            "default": 0
        },
        "zone": {
            "type": "string",
            "default": "douala"
        }
    },
    "required": [
        "first_name",
        "last_name",
        "phone"
    ]
}