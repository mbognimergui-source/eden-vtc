{
    "title": "feedbacks",
    "type": "object",
    "properties": {
        "id": {
            "type": "integer"
        },
        "user_id": {
            "type": "string"
        },
        "rating": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "Note de 1 à 5 étoiles"
        },
        "category": {
            "type": "string",
            "description": "Catégorie: app, driver, ride, payment, other"
        },
        "message": {
            "type": "string",
            "description": "Message de retour détaillé"
        },
        "status": {
            "type": "string",
            "default": "pending",
            "description": "pending, reviewed, resolved"
        }
    },
    "required": [
        "user_id",
        "rating",
        "category",
        "message"
    ]
}